{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListApprovedPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::northstar-iam-training-example",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "engineering",
            "engineering/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadEngineeringObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::northstar-iam-training-example/engineering/*"
    }
  ]
}
